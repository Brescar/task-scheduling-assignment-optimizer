# Ports exposed on host machine
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend (Symfony 7.4 + PHP 8.4)
APP_ENV=dev
APP_SECRET=4c9a895b6d92ec1734bc1e2c9ef1d7a8

# Frontend (Nuxt 3)
# Note: In Docker, Nuxt server route communicates with backend via the internal Docker network
NUXT_BACKEND_URL=http://backend:80
NUXT_USE_MOCK=false

